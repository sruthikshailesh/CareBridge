rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "");
    }

    function hasRole(role) {
      return signedIn() && myRole() == role;
    }

    // caregiverLinks doc id is "<patientId>_<caregiverId>", so a patient+caregiver
    // pair can be looked up from uids alone.
    function linkStatus(patientId) {
      return get(/databases/$(database)/documents/caregiverLinks/$(patientId + "_" + request.auth.uid)).data.get("status", "none");
    }

    function isLinkedCaregiver(patientId) {
      return signedIn() && linkStatus(patientId) == "accepted";
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ["patient", "caregiver", "clinic"]
        && request.resource.data.onboardingComplete == false
        && request.resource.data.displayName is string
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(["uid", "role", "displayName", "phone", "onboardingComplete", "createdAt"]);

      // Caregivers and clinics need display names of linked users.
      allow read: if signedIn();

      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["uid", "role", "createdAt"]);

      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isSelf(patientId) || hasRole("clinic") || isLinkedCaregiver(patientId);

      allow create, update: if isSelf(patientId)
        && request.resource.data.patientId == patientId
        && request.resource.data.diabetesType in ["type1", "type2", "gestational"]
        && request.resource.data.thresholds.low is number
        && request.resource.data.thresholds.high is number
        && request.resource.data.thresholds.low < request.resource.data.thresholds.high
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.keys().hasOnly(["patientId", "diabetesType", "thresholds", "nextScreeningDate", "clinicianNotes", "createdAt", "updatedAt"]);

      match /settings/{settingId} {
        allow read, create, update, delete: if isSelf(patientId)
          && settingId == "nudges";
      }
    }

    match /consentCodes/{code} {
      // Codes are bearer tokens: any signed-in user may check one, nobody can list them.
      allow get: if signedIn();
      allow list: if false;

      allow create: if hasRole("patient")
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.code == code
        && code.size() == 6
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(["code", "patientId", "createdAt"]);

      allow update: if false;
      allow delete: if isSelf(resource.data.patientId);
    }

    match /caregiverLinks/{linkId} {
      allow read: if isSelf(resource.data.patientId) || isSelf(resource.data.caregiverId) || hasRole("clinic");

      allow create: if hasRole("caregiver")
        && linkId == request.resource.data.patientId + "_" + request.auth.uid
        && request.resource.data.caregiverId == request.auth.uid
        && request.resource.data.linkId == linkId
        && request.resource.data.status == "pending"
        && request.resource.data.consentCode is string
        && request.resource.data.consentCode.size() == 6
        && get(/databases/$(database)/documents/consentCodes/$(request.resource.data.consentCode)).data.patientId == request.resource.data.patientId
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(["linkId", "patientId", "caregiverId", "status", "consentCode", "createdAt", "respondedAt"]);

      allow update: if (isSelf(resource.data.patientId) || isSelf(resource.data.caregiverId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt"])
        && request.resource.data.status in ["pending", "accepted", "declined", "revoked"]
        // accepting/declining is the patient's decision only
        && (request.resource.data.status != "accepted" || isSelf(resource.data.patientId))
        && (request.resource.data.status != "declined" || isSelf(resource.data.patientId));

      allow delete: if false;
    }

    match /logs/{logId} {
      allow read: if isSelf(resource.data.patientId) || hasRole("clinic") || isLinkedCaregiver(resource.data.patientId);

      // Logs are immutable once written (auditability).
      allow create: if hasRole("patient")
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.logId == logId
        && request.resource.data.kind in ["glucose", "tablet", "insulin"]
        && request.resource.data.value is number
        && request.resource.data.timestamp is number
        && request.resource.data.keys().hasOnly(["logId", "patientId", "kind", "value", "timestamp", "note"]);

      allow update, delete: if false;
    }

    match /checkins/{checkinId} {
      allow read: if isSelf(resource.data.caregiverId) || isSelf(resource.data.patientId) || hasRole("clinic");

      allow create: if hasRole("caregiver")
        && request.resource.data.caregiverId == request.auth.uid
        && isLinkedCaregiver(request.resource.data.patientId)
        && request.resource.data.checkinId == checkinId
        && request.resource.data.status in ["ok", "missed", "concern"]
        && request.resource.data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(["checkinId", "caregiverId", "patientId", "date", "status", "note", "createdAt"]);

      allow update: if isSelf(resource.data.caregiverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "note"]);

      allow delete: if false;
    }

    match /clinics/{clinicId} {
      allow read: if signedIn();

      allow create: if isSelf(clinicId)
        && hasRole("clinic")
        && request.resource.data.clinicId == clinicId
        && request.resource.data.clinicName is string
        && request.resource.data.createdAt is number
        && request.resource.data.keys().hasOnly(["clinicId", "clinicName", "address", "phone", "createdAt"]);

      allow update: if isSelf(clinicId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["clinicId", "createdAt"]);

      allow delete: if false;
    }
  }
}
